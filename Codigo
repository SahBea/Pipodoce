// ==========================================
// FECHAMENTO DO DIA
// ==========================================

function obterFechamento(dataEscolhida) {

  const vendas =
    PLANILHA.getSheetByName('VENDAS');

  const compras =
    PLANILHA.getSheetByName('COMPRAS');


  let totalVendas = 0;

  let quantidadeProdutos = 0;

  let totalCompras = 0;


  let pix = 0;

  let dinheiro = 0;

  let cartao = 0;

  let ifood = 0;


  const produtos = {};


  let dataReferencia;


  if (dataEscolhida) {

    const partes =
      dataEscolhida.split('-');

    dataReferencia =
      new Date(
        Number(partes[0]),
        Number(partes[1]) - 1,
        Number(partes[2])
      );

  } else {

    dataReferencia =
      new Date();

  }


  // ========================================
  // VENDAS
  // ========================================

  if (vendas) {

    const dados =
      vendas.getDataRange().getValues();

    for (
      let i = 1;
      i < dados.length;
      i++
    ) {

      const data =
        new Date(dados[i][1]);

      if (
        mesmoDia(
          data,
          dataReferencia
        )
      ) {

        const quantidade =
          Number(dados[i][5]) || 0;

        const valor =
          Number(dados[i][6]) || 0;

        const pagamento =
          String(dados[i][7] || '')
            .trim()
            .toLowerCase();


        totalVendas += valor;

        quantidadeProdutos += quantidade;


        if (pagamento === 'pix') {
          pix += valor;
        }

        if (pagamento === 'dinheiro') {
          dinheiro += valor;
        }

        if (
          pagamento === 'cartão' ||
          pagamento === 'cartao'
        ) {
          cartao += valor;
        }

        if (pagamento === 'ifood') {
          ifood += valor;
        }


        const nomeProduto =
          dados[i][3] +
          ' - ' +
          dados[i][4];


        if (!produtos[nomeProduto]) {
          produtos[nomeProduto] = 0;
        }

        produtos[nomeProduto] += quantidade;

      }

    }

  }


  // ========================================
  // COMPRAS
  // ========================================

  if (compras) {

    const dados =
      compras.getDataRange().getValues();

    for (
      let i = 1;
      i < dados.length;
      i++
    ) {

      const data =
        new Date(dados[i][1]);

      if (
        mesmoDia(
          data,
          dataReferencia
        )
      ) {

        totalCompras +=
          Number(dados[i][4]) || 0;

      }

    }

  }


  return {

    data:
      formatarDataServidor(
        dataReferencia
      ),

    totalVendas:
      totalVendas,

    quantidadeProdutos:
      quantidadeProdutos,

    pix:
      pix,

    dinheiro:
      dinheiro,

    cartao:
      cartao,

    ifood:
      ifood,

    totalCompras:
      totalCompras,

    produtos:
      produtos

  };

}


// ==========================================
// COMPARAR DATAS
// ==========================================

function mesmoDia(
  data1,
  data2
) {

  return (

    data1.getDate() ===
    data2.getDate()

    &&

    data1.getMonth() ===
    data2.getMonth()

    &&

    data1.getFullYear() ===
    data2.getFullYear()

  );

}


// ==========================================
// FORMATAR DATA
// ==========================================

function formatarDataServidor(data) {

  if (!data) {
    return '';
  }

  const d =
    new Date(data);

  return Utilities.formatDate(
    d,
    Session.getScriptTimeZone(),
    'dd/MM/yyyy HH:mm'
  );

}
