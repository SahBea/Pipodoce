// ==========================================
// CONFIGURAR ESTOQUE V3
// ==========================================

function configurarEstoqueV3() {

  let aba = PLANILHA.getSheetByName('ESTOQUE');

  if (!aba) {
    aba = PLANILHA.insertSheet('ESTOQUE');
  }

  aba.clearContents();

  aba.getRange(1, 1, 1, 3).setValues([
    ['Produto', 'Sabor', 'Quantidade']
  ]);

  const linhas = [];

  Object.keys(PRODUTOS_PIPODOCE).forEach(function(produto) {

    PRODUTOS_PIPODOCE[produto].forEach(function(sabor) {

      linhas.push([
        produto,
        sabor,
        0
      ]);

    });

  });

  if (linhas.length > 0) {

    aba.getRange(
      2,
      1,
      linhas.length,
      3
    ).setValues(linhas);

  }

  aba.getRange('A1:C1')
    .setFontWeight('bold');

  aba.autoResizeColumns(1, 3);

  return 'Estoque V3 configurado com sucesso!';

}


// ==========================================
// CONFIGURAR VENDAS V3
// ==========================================

function configurarVendasV3() {

  const aba = PLANILHA.getSheetByName('VENDAS');

  if (!aba) {
    return 'Aba VENDAS não encontrada.';
  }

  const cabecalho =
    aba.getRange(1, 1, 1, 8).getValues()[0];

  if (cabecalho[4] !== 'Sabor') {
    aba.insertColumnAfter(4);
  }

  aba.getRange(1, 1, 1, 8).setValues([

    [
      'ID',
      'Data',
      'Vendedor',
      'Produto',
      'Sabor',
      'Quantidade',
      'Valor',
      'Pagamento'
    ]

  ]);

  return 'Vendas V3 configuradas com sucesso!';

}


// ==========================================
// LOGIN
// ==========================================

function login(usuario, senha) {

  const aba =
    PLANILHA.getSheetByName('USUARIOS');

  if (!aba) {

    return {
      sucesso: false,
      mensagem:
        'A aba USUARIOS não foi encontrada.'
    };

  }

  const dados =
    aba.getDataRange().getValues();

  for (
    let i = 1;
    i < dados.length;
    i++
  ) {

    const nome = dados[i][1];
    const user = dados[i][2];
    const password = dados[i][3];

    if (

      String(user).trim() ===
      String(usuario).trim()

      &&

      String(password).trim() ===
      String(senha).trim()

    ) {

      return {

        sucesso: true,

        nome: nome,

        usuario: user

      };

    }

  }

  return {

    sucesso: false,

    mensagem:
      'Usuário ou senha incorretos.'

  };

}


