// ==========================================
// RESUMO DO DASHBOARD
// ==========================================

function obterResumo() {

  const vendas =
    PLANILHA.getSheetByName('VENDAS');

  const compras =
    PLANILHA.getSheetByName('COMPRAS');

  let totalVendas = 0;

  let quantidadeVendida = 0;

  let totalCompras = 0;

  const hoje = new Date();


  // VENDAS

  if (vendas) {

    const dados =
      vendas.getDataRange().getValues();

    for (
      let i = 1;
      i < dados.length;
      i++
    ) {

      const data =
        new Date(dados[i][1]);

      if (mesmoDia(data, hoje)) {

        quantidadeVendida +=
          Number(dados[i][5]) || 0;

        totalVendas +=
          Number(dados[i][6]) || 0;

      }

    }

  }


  // COMPRAS

  if (compras) {

    const dados =
      compras.getDataRange().getValues();

    for (
      let i = 1;
      i < dados.length;
      i++
    ) {

      const data =
        new Date(dados[i][1]);

      if (mesmoDia(data, hoje)) {

        totalCompras +=
          Number(dados[i][4]) || 0;

      }

    }

  }


  return {

    vendas: totalVendas,

    quantidade: quantidadeVendida,

    compras: totalCompras

  };

}


// ==========================================
// REGISTRAR VENDA
// ==========================================

function registrarVenda(
  usuario,
  produto,
  sabor,
  quantidade,
  valor,
  pagamento
) {

  const aba =
    PLANILHA.getSheetByName('VENDAS');

  if (!aba) {

    return {

      sucesso: false,

      mensagem:
        'Aba VENDAS não encontrada.'

    };

  }

  quantidade =
    Number(quantidade);

  valor =
    Number(valor);


  if (!produto) {

    return {
      sucesso: false,
      mensagem:
        'Selecione o produto.'
    };

  }


  if (!sabor) {

    return {
      sucesso: false,
      mensagem:
        'Selecione o sabor.'
    };

  }


  if (
    !quantidade ||
    quantidade <= 0
  ) {

    return {

      sucesso: false,

      mensagem:
        'Informe uma quantidade válida.'

    };

  }


  if (
    !valor ||
    valor <= 0
  ) {

    return {

      sucesso: false,

      mensagem:
        'Informe o valor da venda.'

    };

  }


  if (!pagamento) {

    return {

      sucesso: false,

      mensagem:
        'Selecione a forma de pagamento.'

    };

  }


  // VERIFICAR ESTOQUE

  const estoque =
    obterEstoqueProduto(
      produto,
      sabor
    );


  if (quantidade > estoque) {

    return {

      sucesso: false,

      mensagem:
        'Estoque insuficiente. ' +
        produto +
        ' / ' +
        sabor +
        ' possui apenas ' +
        estoque +
        ' unidade(s).'

    };

  }


  // ID

  const id =
    aba.getLastRow();


  // REGISTRAR VENDA

  aba.appendRow([

    id,

    new Date(),

    usuario,

    produto,

    sabor,

    quantidade,

    valor,

    pagamento

  ]);


  // BAIXAR ESTOQUE

  atualizarEstoqueProduto(

    produto,

    sabor,

    -quantidade

  );


  return {

    sucesso: true,

    mensagem:
      'Venda registrada com sucesso!'

  };

}


