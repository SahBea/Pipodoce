// ==========================================
// OBTER ESTOQUE COMPLETO
// ==========================================

function obterEstoqueCompleto() {

  const aba =
    PLANILHA.getSheetByName('ESTOQUE');

  if (!aba) {
    return [];
  }

  const dados =
    aba.getDataRange().getValues();

  return dados
    .slice(1)
    .map(function(linha) {

      return {

