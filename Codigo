        sabor: linha[1],

        quantidade:
          Number(linha[2]) || 0

      };

    });

}


// ==========================================
// OBTER ESTOQUE DE PRODUTO + SABOR
// ==========================================

function obterEstoqueProduto(
  produto,
  sabor
) {

  const aba =
    PLANILHA.getSheetByName('ESTOQUE');

  if (!aba) {
    return 0;
  }

  const dados =
    aba.getDataRange().getValues();

  for (
    let i = 1;
    i < dados.length;
    i++
  ) {

    if (

      String(dados[i][0]).trim()
        .toLowerCase() ===
      String(produto).trim()
        .toLowerCase()

      &&

      String(dados[i][1]).trim()
        .toLowerCase() ===
      String(sabor).trim()
        .toLowerCase()

    ) {

      return Number(dados[i][2]) || 0;

    }

  }

  return 0;

}


// ==========================================
// ATUALIZAR ESTOQUE
// ==========================================

function atualizarEstoqueProduto(
  produto,
  sabor,
  valor
) {

  const aba =
    PLANILHA.getSheetByName('ESTOQUE');

  if (!aba) {
    return false;
  }

  const dados =
    aba.getDataRange().getValues();

  for (
    let i = 1;
    i < dados.length;
    i++
  ) {

    if (

      String(dados[i][0]).trim()
        .toLowerCase() ===
      String(produto).trim()
        .toLowerCase()

      &&

      String(dados[i][1]).trim()
        .toLowerCase() ===
      String(sabor).trim()
        .toLowerCase()

    ) {

      const atual =
        Number(dados[i][2]) || 0;

      const novo =
        atual + Number(valor);

      aba.getRange(i + 1, 3)
        .setValue(novo);

      return true;

    }

  }

  return false;

}


// ==========================================
// ADICIONAR ESTOQUE
// ==========================================

function adicionarEstoque(
  produto,
  sabor,
  quantidade
) {

  quantidade =
    Number(quantidade);

  if (!produto) {

    return {

      sucesso: false,

      mensagem:
        'Selecione o produto.'

    };

  }

  if (!sabor) {

    return {

      sucesso: false,

      mensagem:
        'Selecione o sabor.'

    };

  }

  if (
    isNaN(quantidade) ||
    quantidade <= 0
  ) {

    return {

      sucesso: false,

      mensagem:
        'Digite uma quantidade válida.'

    };

  }

  const existe =
    obterEstoqueProduto(
      produto,
      sabor
    );

  const atualizado =
    atualizarEstoqueProduto(
      produto,
      sabor,
      quantidade
    );

  if (!atualizado) {

    return {

      sucesso: false,

      mensagem:
        'Produto e sabor não encontrados no estoque.'

    };

  }

  return {

    sucesso: true,

    mensagem:
      'Estoque atualizado com sucesso!',

    estoque:
      existe + quantidade

  };

}


